#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# Adapted from AirSimHub ea019485 node/deploy/audio/rmtfs-local-profile.
# This device's verified private shadow is READ ONLY; no profile ships in an image.
set -eu
LC_ALL=C
export LC_ALL
owner=0
test "$(id -u)" = "$owner"
check=no
case ${1:-} in '') ;; --check) check=yes;; *) exit 2;; esac
marker=/var/lib/rustsimhub/rustsimhub-v1/system/carrier-voice.enabled
profile=/var/lib/rustsimhub/.private-modem/local-volte
compatible=/proc/device-tree/compatible
if [ ! -e "$marker" ] && [ ! -L "$marker" ]; then
 if [ "$check" = yes ]; then echo 'rmtfs profile: original read-only partitions'; exit 0; fi
 exec /usr/bin/rmtfs -r -P -s
fi
test -f "$marker" && test ! -L "$marker"
test "$(stat -c '%u:%g:%a:%h' "$marker")" = "$owner:$owner:600:1"
test "$(cat "$marker")" = RustSimHub.Ufi003.Unicom.VoLTE.v1
/usr/local/libexec/rustsimhub-state-check --read-only
tr '\000' '\n' < "$compatible" | grep -qx 'thwc,ufi003'
for folder in /var/lib/rustsimhub/.private-modem "$profile"; do
 test -d "$folder" && test ! -L "$folder"
 test "$(stat -c '%u:%g:%a' "$folder")" = "$owner:$owner:700"
done
for name in SHA256SUMS modem_fs1 modem_fs2 modem_fsc modem_fsg; do
 test -f "$profile/$name" && test ! -L "$profile/$name"
 test "$(stat -c '%u:%g:%a:%h' "$profile/$name")" = "$owner:$owner:600:1"
done
test "$(stat -c %s "$profile/SHA256SUMS")" -le 4096
awk '
 NF != 2 || length($1) != 64 || $1 ~ /[^0-9a-f]/ { exit 1 }
 $2 !~ /^(modem_fs1|modem_fs2|modem_fsc|modem_fsg)$/ { exit 1 }
 seen[$2]++ { exit 1 }
 END { if (length(seen) != 4) exit 1 }
' "$profile/SHA256SUMS"
(cd "$profile" && sha256sum --status -c SHA256SUMS)
if [ "$check" = yes ]; then echo 'rmtfs profile: private owner shadow verified; no change'; exit 0; fi
echo 'rmtfs: verified private owner profile, read-only shadow mode'
exec /usr/bin/rmtfs -r -o "$profile" -s
