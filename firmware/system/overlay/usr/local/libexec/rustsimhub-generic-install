#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# Generic flash first boot only: run the normal trusted initial installation with values
# that exist on no other device. The request marker comes from the signed flash pack.
# The one-time setup code stays in the Root-private handoff directory.
set -eu
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
test "$#" = 0
test "$(id -u)" = 0
/usr/local/libexec/rustsimhub-state-check
system=/var/lib/rustsimhub/rustsimhub-v1/system
request=$system/generic-provision.request
test ! -L "$request"
test -f "$request"
test "$(stat -c '%u:%g:%a:%h' "$request")" = 0:0:600:1
test "$(cat "$request")" = RustSimHub.GenericProvision.v1
if test -e "$system/installation.complete" || test -L "$system/installation.complete";then
 echo 'generic install: already complete; nothing changed'
 exit 0
fi
serial=$system/usb.serial
test ! -L "$serial"
test -f "$serial"
test "$(stat -c '%u:%g:%a:%h:%s' "$serial")" = 0:0:600:1:33
LC_ALL=C grep -aqxE '[0-9a-f]{32}' "$serial"
name=rustsimhub-$(cut -c1-4 "$serial")
target=/etc/rustsimhub/device-name
pending=$target.pending
if test -e "$target" || test -L "$target";then
 test ! -L "$target"
 test -f "$target"
 test "$(cat "$target")" = "$name"
else
 test ! -L "$pending"
 rm -f -- "$pending"
 (umask 022;set -C;printf '%s\n' "$name" > "$pending")
 chmod 0644 "$pending"
 sync -f "$pending"
 mv -nT -- "$pending" "$target"
 test ! -e "$pending"
 sync -f "$(dirname "$target")"
fi
# usb0 is the only address known on every device before Wi-Fi exists. The first name is
# .local, so Edge also follows wlan0; the media worker uses the same two sets of addresses.
# Explicit immutable v1 opt-in only. The durable request precedes identity setup,
# so a power cut after installation.complete cannot lose the AP preparation intent.
# Old devices with installation.complete returned above; no new request is created.
if test -e /usr/share/rustsimhub/firstboot-ap/manifest.json || test -L /usr/share/rustsimhub/firstboot-ap/manifest.json;then
 /usr/local/libexec/rustsimhub-firstboot-ap --request
fi
exec /usr/local/libexec/rustsimhub-install-initialize \
 "$system/ssh-access/authorized_keys" 10.55.0.2:8443 "$name.local,10.55.0.2" \
 "$system/first-owner-handoff" --media-lan
