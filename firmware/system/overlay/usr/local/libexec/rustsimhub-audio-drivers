#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# Immutable board profile only. No caller-supplied module or modprobe options.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
unset MODPROBE_OPTIONS
profile=/usr/share/rustsimhub/audio-driver-profile
test -f "$profile" && test ! -L "$profile"
test "$(stat -c '%u:%g:%a:%h' "$profile")" = 0:0:444:1
exec 3< "$profile"
IFS= read -r release <&3
test "$release" = 6.12.49-msm8916-g93a71ee9468d
test "$(uname -r)" = "$release"
for module in q6afe-dai q6asm-dai q6voice-dai snd-soc-apq8016-sbc; do
 /usr/sbin/modprobe -C /dev/null --ignore-install "$module"
done
count=0
while read -r module version extra <&3; do
 test -z "$extra" && test -n "$module" && test "${#version}" = 24
 case "$module" in *[!a-zA-Z0-9_]*|'') exit 1;; esac
 case "$version" in *[!0-9A-F]*|'') exit 1;; esac
 test "$(cat "/sys/module/$module/srcversion")" = "$version"
 count=$((count+1))
done
test "$count" = 16
