#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# Policy adapted from AirSimHub ea019485 node/deploy/carrier/nassimhub-carrier-voice.
# Fixed Root Rust helper; no APN/MBN/NV writes. Marker is per-device opt-in.
set -eu
umask 077
LC_ALL=C
export LC_ALL
helper=/usr/libexec/rustsimhub/rustsimhub-network-agent
owned=/run/rustsimhub-carrier-voice/ps-applied
/usr/local/libexec/rustsimhub-rmtfs-profile --check
marker=/var/lib/rustsimhub/rustsimhub-v1/system/carrier-voice.enabled
test -f "$marker" && test ! -L "$marker"
sample() {
 state=
 if [ -e "$owned" ] || [ -L "$owned" ]; then
  [ -f "$owned" ] && [ ! -L "$owned" ] || return 0
  [ "$(stat -c '%u:%g:%a:%h' "$owned")" = 0:0:600:1 ] || return 0
  state=$(cat "$owned")
  case "$state" in RustSimHub.CarrierVoice.Intent.v1.ps|RustSimHub.CarrierVoice.Intent.v1.cs) ;; *) return 0;; esac
 fi
 report=$(mmcli --timeout=3 -m any -K 2>/dev/null) || return 0
 sim=$(printf '%s\n' "$report" | awk '$1 == "modem.generic.sim" && $2 == ":" { print $3; exit }')
 printf '%s\n' "$sim" | grep -Eq '^/org/freedesktop/ModemManager1/SIM/[0-9]+$' || return 0
 report=$(mmcli --timeout=3 -i "$sim" -K 2>/dev/null) || return 0
 operator=$(printf '%s\n' "$report" | awk '$1 == "sim.properties.operator-code" && $2 == ":" { print $3; exit }')
 printf '%s\n' "$operator" | grep -Eq '^[0-9]{5,6}$' || return 0
 case "$operator" in 46001|46009) action=--voice-domain-ps-preferred;; *) action=--voice-domain-cs-preferred;; esac
 if [ "$action" = --voice-domain-cs-preferred ] && [ -z "$state" ]; then return 0; fi
 # Retained terminal objects are history; any other object/state blocks changes.
 calls=$(mmcli --timeout=3 -m any --voice-list-calls 2>/dev/null) || return 0
 if [ "$calls" != 'No calls were found' ] && [ "$calls" != 'No calls were found.' ]; then
  printf '%s\n' "$calls" | awk '
   NF != 3 || $1 !~ /^\/org\/freedesktop\/ModemManager1\/Call\/[0-9]+$/ || $2 !~ /^(incoming|outgoing)$/ || $3 != "(terminated)" { exit 1 }
   END { if (NR < 1 || NR > 64) exit 1 }
  ' || return 0
 fi
 current=$("$helper" --voice-domain-get 2>/dev/null) || return 0
 if [ "$action" = --voice-domain-ps-preferred ]; then
  # Persist intent BEFORE the only mutation. Even a lost response or a service
  # restart cannot silently repeat it. A preexisting PS preference is not ours.
  [ "$current" = voice-domain=2 ] && [ -z "$state" ] || return 0
  (set -C; printf 'RustSimHub.CarrierVoice.Intent.v1.ps\n' > "$owned") || return 0
  sync -f "$owned"
  if "$helper" "$action" >/dev/null 2>&1; then echo 'carrier voice: Unicom runtime PS preference read back'; fi
 else
  if [ "$current" = voice-domain=2 ]; then rm -- "$owned"; return 0; fi
  [ "$current" = voice-domain=3 ] && [ "$state" = RustSimHub.CarrierVoice.Intent.v1.ps ] || return 0
  (set -C; printf 'RustSimHub.CarrierVoice.Intent.v1.cs\n' > "$owned.pending") || return 0
  sync -f "$owned.pending"
  mv -T -- "$owned.pending" "$owned"
  sync -f "$owned"
  if "$helper" "$action" >/dev/null 2>&1; then
   rm -- "$owned"
   echo 'carrier voice: restored own previous CS preference after carrier change'
  fi
 fi
}
trap 'exit 0' INT TERM
while :; do sample; sleep 15 & wait $!; done
