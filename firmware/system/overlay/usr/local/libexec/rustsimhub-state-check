#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# Fixed first-board guard; reads metadata only, never formats or repairs storage.
set -eu
test "$#" = 0
state=/var/lib/rustsimhub
tr '\000' '\n' < /proc/device-tree/compatible | grep -qx 'thwc,ufi003'
test ! -L "$state"
mountpoint -q "$state"
# PrivateDevices hides physical /dev nodes in the SSH preparation unit.
# Compare the mounted filesystem's kernel device number with the fixed physical
# partition in sysfs; this does not require exposing or opening a block device.
partition=/sys/class/block/mmcblk0p15
test "$(dirname "$(readlink -f "$partition")")" = "$(readlink -f /sys/class/block/mmcblk0)"
test "$(findmnt -rn -M "$state" -o MAJ:MIN)" = "$(cat "$partition/dev")"
test "$(cat "$partition/partition")" = 15
grep -qx 'PARTNAME=NSHSTATE' "$partition/uevent"
test "$(cat /sys/class/block/mmcblk0p15/size)" = 264159
test "$(findmnt -rn -M "$state" -o FSTYPE)" = ext4
test "$(findmnt -rn -M "$state" -o LABEL)" = NSHSTATE
case ",$(findmnt -rn -M "$state" -o OPTIONS)," in *,rw,*) ;; *) exit 1;; esac
test "$(stat -c %d "$state")" != "$(stat -c %d /)"
