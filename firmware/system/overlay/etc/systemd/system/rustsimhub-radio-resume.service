[Unit]
Description=Resume UFI003 radio after verified owner firmware is loaded
Requires=rustsimhub-device-firmware.service rmtfs.service
Wants=qrtr-ns.service
After=rustsimhub-device-firmware.service rmtfs.service qrtr-ns.service
Before=ModemManager.service NetworkManager.service rustsimhub-core.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/rustsimhub-radio-resume
RemainAfterExit=yes
TimeoutStartSec=75

[Install]
WantedBy=multi-user.target
