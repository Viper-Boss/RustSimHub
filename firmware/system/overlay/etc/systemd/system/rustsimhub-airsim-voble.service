[Unit]
Description=RustSimHub AirSIM Bluetooth agent
ConditionPathExists=/var/lib/rustsimhub/rustsimhub-v1/system/installation.complete
ConditionFileIsExecutable=/usr/local/libexec/rustsimhub-airsim-pairing
ConditionPathExists=/var/lib/rustsimhub/rustsimhub-v1/system/voble/state.json
Wants=bluetooth.service
After=bluetooth.service rustsimhub-edge.service
PartOf=bluetooth.service
StartLimitIntervalSec=60
StartLimitBurst=8

[Service]
Type=exec
ExecCondition=/bin/sh -c '/usr/local/libexec/rustsimhub-airsim-pairing status /var/lib/rustsimhub/rustsimhub-v1/system/voble | /usr/bin/grep -Fxq paired'
ExecStart=/usr/local/libexec/rustsimhub-airsim-pairing serve /var/lib/rustsimhub/rustsimhub-v1/system/voble
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
ProtectSystem=strict
ReadWritePaths=/var/lib/rustsimhub/rustsimhub-v1/system/voble
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
# Resolve /proc/<bluetoothd-pid>/exe for the authenticated D-Bus owner.
CapabilityBoundingSet=CAP_SYS_PTRACE
SystemCallFilter=~ptrace process_vm_readv process_vm_writev
UMask=0077
LimitCORE=0

[Install]
WantedBy=multi-user.target
