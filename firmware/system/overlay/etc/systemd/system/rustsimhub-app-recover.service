[Unit]
Description=Bounded automatic application group recovery
ConditionPathExists=/var/lib/rustsimhub/rustsimhub-v1/system/installation.complete
After=rustsimhub-core.service rustsimhub-media.service rustsimhub-edge.service rustsimhub-app-select.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/rustsimhub-app-recover
BindPaths=/opt/rustsimhub/versions:/var/lib/rustsimhub/rustsimhub-v1/system/app/versions
ReadWritePaths=/run/rustsimhub-app /var/lib/rustsimhub/rustsimhub-v1/system/app
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
TimeoutStartSec=25
