[Unit]
Description=Initialize the seven fixed UFI003 voice routes without PCM
Requires=rustsimhub-audio-drivers.service dev-snd-controlC0.device
Wants=alsa-restore.service
After=rustsimhub-audio-drivers.service alsa-restore.service dev-snd-controlC0.device
Before=rustsimhub-core.service rustsimhub-media.service
# Bound the complete job, including waiting for the device dependency.
JobTimeoutSec=60

[Service]
Type=oneshot
User=root
ExecStart=/usr/libexec/rustsimhub/rustsimhub-audio-platform --prepare-routes
RemainAfterExit=yes
# Allow the helper's bounded 20-second card-enumeration wait plus ALSA readback.
TimeoutStartSec=30
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=/dev/snd/controlC0 rw
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
MemoryMax=32M
TasksMax=4
UMask=0077
