[Unit]
Description=RustSimHub local HTTPS edge
Requires=rustsimhub-app-select.service rustsimhub-core.service
After=rustsimhub-app-select.service rustsimhub-core.service
PartOf=rustsimhub-app.target
OnFailure=rustsimhub-app-recover.service

[Service]
Type=exec
User=rustsimhub-edge
Group=rustsimhub-edge
SupplementaryGroups=rustsimhub-ipc
ExecStartPre=/usr/local/libexec/rustsimhub-edge-ready
ExecStart=/opt/rustsimhub/selected/rustsimhub-edge --serve /var/lib/rustsimhub-edge/config.json
BindReadOnlyPaths=/run/rustsimhub-app/selected:/opt/rustsimhub/selected /var/lib/rustsimhub/rustsimhub-v1/edge:/var/lib/rustsimhub-edge /run/rustsimhub/core
InaccessiblePaths=/run/dbus /var/lib/rustsimhub /var/lib/rustsimhub-core
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
MemoryMax=64M
TasksMax=8
TimeoutStopSec=5
LimitCORE=0
