// SPDX-License-Identifier: AGPL-3.0-only
// Installation candidate only. No arbitrary unit or job mode from a browser.
polkit.addRule(function(action, subject) {
    var roles = ["rustsimhub-core", "rustsimhub-edge", "rustsimhub-media", "rustsimhub-forwarder"];
    if (roles.indexOf(subject.user) < 0 || action.id !== "org.freedesktop.systemd1.manage-units") { return; }
    var units = ["rustsimhub-forwarder-reconcile.service", "rustsimhub-forwarder-status.service"];
    if (subject.user === "rustsimhub-core" && action.lookup("verb") === "start" && units.indexOf(action.lookup("unit")) >= 0) {
        return polkit.Result.YES;
    }
    return polkit.Result.NO;
});
